# Local development environment for `make run-core` / `make run-worker`.
# Copy to .env.local (git-ignored). Never put secrets here: the bot token and
# Instagram cookies live in the core database (core settings set ...).

# Core
DB_PATH=./data/quoker.db
HTTP_ADDR=127.0.0.1:8080
FILES_ADDR=127.0.0.1:8081
GRPC_ADDR=127.0.0.1:9090
CACHE_DIR=./data/cache
# Where workers upload covers and files; in production derived from DOMAIN.
UPLOAD_BASE=http://127.0.0.1:8081/internal/v1
LOG_LEVEL=debug

# Worker (only used by make run-worker)
WORKER_ID=local-worker-1
CORE_ADDR=127.0.0.1:9090
# CLIENT_CERT, CLIENT_KEY, CA_CERT — omit for insecure local dev
MAX_PARALLEL=2
YTDLP_BIN=yt-dlp
TMP_DIR=./data/worker-tmp
TMP_CACHE_MAX_BYTES=1073741824
