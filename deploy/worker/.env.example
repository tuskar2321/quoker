# Worker server environment. Copy to /opt/app/.env and fill in.
# Bot token and Instagram cookies are NOT here: the core sends them to the worker.

# Image tags (ghcr.io/tuskar2321/quoker-*). Never "latest".
# WORKER_TAG is the worker release, e.g. 1.2.0 for tag worker-v1.2.0.
WORKER_TAG=0.1.0
XRAY_TAG=26.10.31

# Worker identity: must equal the CN of worker.crt and the id allowed on the core (/allow_worker).
WORKER_ID=worker-1
# core gRPC endpoint through Caddy, host:port. Certificate is for w.<domain>.
CORE_ADDR=w.example.ru:443

# direct: connect to CORE_ADDR over the internet (default).
# reality: connect through the xray tunnel below. Use only when the direct path is blocked.
TRANSPORT=direct
# Required when TRANSPORT=reality. Local xray entry point, always xray:10443.
CORE_DIAL_ADDR=

MAX_PARALLEL=2
TMP_CACHE_MAX_BYTES=1073741824
YTDLP_BIN=/usr/local/bin/yt-dlp
# Empty means the built-in mobile user agent.
USER_AGENT=
LOG_LEVEL=info
TZ=UTC

# REALITY client settings (used only with TRANSPORT=reality and --profile fallback).
# The values must match the core's .env: the same UUID and short id, and the public key of the
# private key stored on the core. REALITY_SERVER is the core's public IP (or api.<domain>).
# CORE_HOST is the host of CORE_ADDR, used as the destination behind the tunnel.
REALITY_SERVER=
REALITY_UUID=
REALITY_PUBLIC_KEY=
REALITY_SHORT_ID=
REALITY_SNI=
CORE_HOST=w.example.ru
