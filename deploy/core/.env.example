# Core server environment. Copy to /opt/app/.env and fill in.
# Never commit the filled file. Bot token and Instagram cookies are NOT here:
# they live in the core database (core settings set bot_token -, /cookies).

# Image tags (ghcr.io/tuskar2321/quoker-*). Never "latest".
# CORE_TAG is the version of the core release, e.g. 1.2.0 for tag core-v1.2.0.
CORE_TAG=0.1.0
# Mirrors of the official images, see the mirror-images workflow.
CADDY_TAG=2.11.9
XRAY_TAG=26.10.31

# Domain (DNS at the registrar, no proxying): api.<DOMAIN> and w.<DOMAIN> -> core IP.
DOMAIN=example.ru
# Let's Encrypt account e-mail for expiry notices.
ACME_EMAIL=owner@example.com

# Paths inside the containers (they map to ./data, ./cache, ./releases, ./backups).
DB_PATH=/data/quoker.db
CACHE_DIR=/cache
CACHE_MAX_BYTES=3221225472
RELEASES_DIR=/releases
BACKUP_DIR=/backups

# Listen addresses inside the container network. Only Caddy reaches them.
HTTP_ADDR=:8080
FILES_ADDR=:8081
GRPC_ADDR=:9090

# Empty means derived from DOMAIN: UPLOAD_BASE=https://w.<DOMAIN>/internal/v1,
# PUBLIC_URL=https://api.<DOMAIN>. Set them only for local development.
UPLOAD_BASE=
PUBLIC_URL=
# Empty means the default: loopback and private ranges, which include the
# backend network 172.30.0.0/24 used by Caddy.
TRUSTED_PROXIES=

LOG_LEVEL=info
TZ=Europe/Moscow

# REALITY fallback (only with: docker compose --profile fallback up -d xray).
# Generate and keep these in a password manager. They must NOT be shared with the personal VPN.
#   REALITY_PRIVATE_KEY and REALITY_PUBLIC_KEY: docker run --rm ghcr.io/xtls/xray-core:<XRAY_TAG> x25519
#   REALITY_UUID: docker run --rm ghcr.io/xtls/xray-core:<XRAY_TAG> uuid
#   REALITY_SHORT_ID: openssl rand -hex 8
# REALITY_DEST is a real TLS 1.3 + HTTP/2 site that the probes see; REALITY_SNI must be a name it serves.
REALITY_PRIVATE_KEY=
REALITY_UUID=
REALITY_SHORT_ID=
REALITY_DEST=
REALITY_SNI=
